{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "module": "Preserve",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.d.ts",
    "src/**/*.ts",
    "tooling/**/*.ts",
    "tooling/**/*.mts",
    "bootstrap/**/*.ts",
    "bootstrap/**/*.mts",
    "diagnostics/**/*.ts",
    "harness/**/*.ts",
    "harness/**/*.cts",
    "harness/**/*.mts",
    "test/typecheck/**/*.ts",
    "test/fixture/scenario/ts-node/**/*.ts",
    "test/*.test.mts",
    "test/vitest/**/*.mts",
    "vitest.config.mts"
  ],
  "exclude": ["src/vendor", "test/vendor"]
}
