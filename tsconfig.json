{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "module": "Preserve",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.d.ts",
    "src/**/*.ts",
    "script/src/**/*.ts",
    "src/bootstrap/**/*.ts",
    "debug/**/*.ts",
    "test/harness/**/*.ts",
    "test/harness/**/*.cts",
    "test/typecheck/**/*.ts",
    "test/fixture/scenario/ts-node/**/*.ts",
    "test/vitest/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/vendor", "test/vendor"]
}
