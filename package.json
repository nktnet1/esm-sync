{
  "name": "esm-sync",
  "version": "3.4.0",
  "description": "Tomorrow's ECMAScript modules today!",
  "license": "MIT",
  "author": "Khiet Tam Nguyen",
  "scripts": {
    "audit:all": "pnpm audit --audit-level high",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prepub": "pnpm fixtures:prepare && pnpm verify:prod && pnpm build:prod",
    "prepublishOnly": "pnpm fixtures:acorn && pnpm build:prod",
    "build": "node script/src/esm/cli.ts build",
    "build:prod": "pnpm build --prod",
    "build:await": "node script/src/esm/cli.ts build-sync-await --required",
    "benchmark:await": "node script/src/esm/cli.ts benchmark-async",
    "install": "node -e \"if(require('fs').existsSync('dist/script/build-sync-await.js'))require('./dist/script/build-sync-await.js')({preferPrebuilt:true})\"",
    "clean": "node script/src/esm/cli.ts clean",
    "fixtures:acorn": "node script/src/esm/cli.ts setup-fixtures acorn",
    "fixtures:prepare": "node script/src/esm/cli.ts setup-fixtures",
    "fixtures:test262": "node script/src/esm/cli.ts setup-fixtures test262",
    "lint": "biome check .",
    "lint:unused": "knip",
    "lint:fix": "biome check --write .",
    "pub": "node script/src/esm/cli.ts publish",
    "test": "pnpm fixtures:prepare && pnpm build --test && pnpm test:run",
    "test:prod": "pnpm fixtures:prepare && pnpm build --prod --test && pnpm test:run:prod",
    "test:run": "pnpm test:vitest",
    "test:run:prod": "pnpm test:vitest:prod",
    "test:conformance": "pnpm fixtures:prepare && pnpm build --test && pnpm test:conformance:run",
    "test:conformance:run": "node script/src/esm/cli.ts run-test262",
    "test:packed": "node script/src/esm/cli.ts test-packed",
    "test:vitest": "node script/src/esm/cli.ts test",
    "test:vitest:prod": "node script/src/esm/cli.ts test --prod",
    "typecheck": "node script/src/esm/cli.ts typecheck",
    "typecheck:tsc": "node script/src/esm/cli.ts typecheck",
    "verify:prod": "pnpm build:prod --test && pnpm test:run:prod",
    "test:verdaccio": "node script/src/esm/cli.ts test-verdaccio",
    "release:beta": "node script/src/esm/release-beta.ts",
    "release:pack": "node script/src/esm/prepare-release-package.ts",
    "release:publish": "node script/src/esm/publish-release-package.ts",
    "benchmark:startup": "node script/src/benchmark-startup.ts"
  },
  "main": "./dist/esm.js",
  "types": "./dist/esm.d.ts",
  "private": false,
  "runkitExample": "require = require(\"esm-sync\")(module)\nrequire(\"lodash-es\")",
  "esm": true,
  "engines": {
    "node": ">=6"
  },
  "keywords": [
    "commonjs",
    "ecmascript",
    "export",
    "import",
    "modules",
    "node",
    "require"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/esm-sync"
  },
  "files": [
    "esm.js",
    "esm.d.ts",
    "index.js",
    "index.d.ts",
    "dist/esm.d.ts",
    "dist/index.d.ts",
    "dist/esm.js",
    "dist/index.js",
    "dist/esm/loader.js",
    "dist/native/*.node",
    "dist/script/build-sync-await.js",
    "native/sync-await.cc"
  ],
  "dependencies": {
    "punycode": "^2.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/helper-plugin-utils": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-catch-binding": "^7.18.6",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-block-scoping": "^7.29.11",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@biomejs/biome": "2.5.15",
    "@hapi/lab": "^26.0.1",
    "@std/esm": "^0.26.0",
    "@types/node": "^26.6.5",
    "acorn": "^8.19.0",
    "adm-zip": "^0.6.1",
    "ava": "^1.4.1",
    "babel-plugin-transform-for-of-as-array": "^1.1.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-plugin-transform-remove-debugger": "^6.9.4",
    "bluebird": "^3.7.2",
    "chai": "^6.3.0",
    "commander": "^15.0.0",
    "core-js": "^2.6.12",
    "execa": "^5.1.1",
    "express": "^5.3.0",
    "flow-remove-types": "^2.337.0",
    "fs-extra": "^11.4.1",
    "global-prefix": "^4.0.0",
    "globby": "^11.1.0",
    "jasmine": "^6.3.0",
    "jest": "^26.6.3",
    "json-6": "^1.1.7",
    "knip": "6.43.0",
    "lefthook": "^2.2.2",
    "lit-node": "^0.1.1",
    "mocha": "^8.4.0",
    "mock-require": "^3.0.3",
    "mock-stdio": "^1.0.3",
    "module-alias": "^2.3.4",
    "newrelic": "^12.25.1",
    "nop": "^1.0.0",
    "npm-check-updates": "23.1.1",
    "nyc": "^18.0.0",
    "pm2": "^7.1.1",
    "postcss": "^8.5.31",
    "proxyquire": "^2.1.3",
    "require-inject": "^1.4.4",
    "requizzle": "^0.2.4",
    "rewire": "^9.0.1",
    "semver": "^7.8.5",
    "sinon": "^22.1.0",
    "strip-ansi": "^6.0.1",
    "test262-parser": "^2.2.0",
    "trash": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "unexpected": "^13.2.1",
    "vitest": "^5.0.5",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12"
  },
  "packageManager": "pnpm@12.15.0",
  "exports": {
    ".": {
      "types": "./dist/esm.d.ts",
      "default": "./dist/esm.js"
    },
    "./package.json": "./package.json",
    "./esm": {
      "types": "./dist/esm.d.ts",
      "default": "./dist/esm.js"
    },
    "./esm.js": {
      "types": "./dist/esm.d.ts",
      "default": "./dist/esm.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
