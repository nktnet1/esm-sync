{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "module": "Preserve",
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "test/harness/**/*.ts",
    "test/harness/**/*.cts",
    "src/types/**/*.d.ts",
    "script/src/**/*.d.ts"
  ],
  "exclude": ["src/vendor"]
}
