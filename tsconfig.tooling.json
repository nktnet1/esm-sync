{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2015",
    "lib": ["ESNext", "DOM"],
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "tooling",
    "outDir": "script",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["tooling/**/*.ts", "tooling/**/*.mts"],
  "exclude": []
}
