{
  "extends": "./tsconfig.source.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["../script/src/**/*.ts", "./**/*.ts", "../tsdown.config.mts"],
  "exclude": []
}
