{
  "compilerOptions": {
    "target": "ESNext",
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "../script/src/semver.d.ts"],
  "exclude": ["../src/vendor", "../src/bootstrap"]
}
